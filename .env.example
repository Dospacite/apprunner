# Copy to .env and fill in. Asgard interpolates this file into compose.yaml at
# deploy time; it is gitignored because every value below is a secret or
# deployment-specific.
#
# Generate the three random values with:
#   openssl rand -hex 32

# Public origin of this server. CI calls back to it, so it must be reachable
# from GitHub Actions.
PUBLIC_URL=https://apprunner.example.com

# Seeded operator account. The password is re-applied on every boot, so
# changing it here and redeploying is how you rotate it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs session cookies.
SESSION_SECRET=
# Encrypts stored GitHub tokens at rest. Changing it makes existing stored
# tokens unreadable; reconnect GitHub afterwards.
ENCRYPTION_KEY=

# Set to false only when running over plain HTTP locally.
COOKIE_SECURE=true

# Your own fork of the pipeline repository, as owner/repo.
CI_REPO=your-name/apprunner-ci
CI_WORKFLOW=build-and-test.yml
CI_REF=main
# Token with actions:write on CI_REPO. A fine-grained PAT scoped to that one
# repository is strongly preferred over a broad personal token.
CI_DISPATCH_TOKEN=

# Firebase Test Lab free tier allowance.
FIREBASE_DAILY_QUOTA=5
